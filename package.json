{
    "name": "express-realtime",
    "version": "1.0.0",
    "description": "Friendly Socket.io layer for Express: notifications, public/private channels, rooms, 1:1 chat and welcome messages on top of your own Socket.io server",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./client": {
            "import": {
                "types": "./dist/client/index.d.ts",
                "default": "./dist/client/index.js"
            },
            "require": {
                "types": "./dist/client/index.d.cts",
                "default": "./dist/client/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "biome check --write .",
        "format:check": "biome check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "docs": "typedoc",
        "example": "tsx examples/server.ts",
        "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
        "check": "npm run lint && npm run format:check",
        "example:client": "tsx examples/client.ts"
    },
    "peerDependencies": {
        "@socket.io/redis-emitter": ">=5.1.0",
        "express": ">=4.18.0",
        "socket.io": ">=4.7.0",
        "socket.io-client": ">=4.7.0"
    },
    "peerDependenciesMeta": {
        "@socket.io/redis-emitter": {
            "optional": true
        },
        "express": {
            "optional": true
        },
        "socket.io": {
            "optional": true
        },
        "socket.io-client": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@socket.io/redis-adapter": "^8.3.0",
        "@socket.io/redis-emitter": "^5.1.0",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.2",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.11.0",
        "express": "^5.2.1",
        "redis": "^6.2.1",
        "semantic-release": "^25.0.9",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "super-configs": "^1.25.1",
        "supertest": "^7.3.0",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typescript": "~6.0.3",
        "vitest": "^5.0.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ElJijuna/express-realtime.git"
    },
    "homepage": "https://github.com/ElJijuna/express-realtime#readme",
    "bugs": {
        "url": "https://github.com/ElJijuna/express-realtime/issues"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
